# Boris Configuration File
#
# Copy this file to ~/.boris/config.ini and adjust it for your environment.
# Settings can also be overridden via environment variables and CLI flags.

[model]
endpoint = http://localhost:8080
name = llama3
api_key = your-api-key-here
temperature = 0.7
# context_window must match your model's context length; max_tokens well below it
context_window = 32768
max_tokens = 8192
timeout_seconds = 120
# Show replies as they arrive (plain text); off renders Markdown when complete
stream = true
verify_ssl = true

[agent]
max_iterations = 16
max_retries = 2
retry_backoff_ms = 1000
text_tool_fallback = false
# Nudge models that emit tool calls as text towards native tool_calls.
# Set to false for models that can only produce text tool calls.
native_tool_reminder = true

[tools]
# Comma list of tools, or: default (everything except fetch), all, none.
# Tools: read, write, edit, list_dir, search, move, delete, memory, run,
#        plan, fetch
enabled = default
sandbox_root = ~/.boris/sandbox
memory_persist = true
# Extra environment variables passed to scripts started by run (comma list).
# Scripts get only PATH, HOME, USER, LOGNAME, LANG, LC_*, TERM, TMPDIR, TZ
# otherwise; BORIS_* variables are never passed.
# run_env = VIRTUAL_ENV
# Longest tool result returned to the model, in bytes (default 135168)
# max_result_bytes = 135168
# Let fetch reach loopback, private and link-local addresses (default false)
# fetch_allow_private = false

[behaviour]
# Ask before each write / script run (needs an interactive terminal)
confirm_writes = false
confirm_run = false
# Ask before each fetch (only applies when fetch is enabled)
confirm_fetch = true

[logging]
level = info
# Append every model request/response to this file as JSON lines (mode 0600)
# trace_file = ~/.boris/trace.jsonl

[output]
# Print each tool call and a short result preview (off with --quiet)
show_tool_calls = true
show_metrics = true

[prompt]
system_prompt_file = ~/.boris/system_prompt.txt
# Project instructions appended to the system prompt: auto (BORIS.md, else
# AGENTS.md, at the sandbox root), none, or a path to a file
instructions = auto
