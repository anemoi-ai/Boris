# Prerequisites
*.d

build/
boris
evals/**/__pycache__/
!evals/fixtures/**/__pycache__/

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Eval runs (results, judge cache) stay local; fixtures are committed whole,
# including the build/ and __pycache__/ directories the tidy test deletes.
evals/results/
!evals/fixtures/**/build/
!evals/fixtures/**/__pycache__/
!evals/fixtures/**
